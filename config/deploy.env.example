# Copia este archivo a config/deploy.env y ajusta los valores para tu VM.
DEPLOY_HOST=agentinder.example
DEPLOY_USER=agentinder-deploy
DEPLOY_ROOT=/opt/agentinder
PUBLIC_ORIGIN=https://agentinder.example

# Opcionales para rotate-key.sh (valores por defecto).
# DEPLOY_ENV_FILE=/etc/agentinder/agentinder.env
# KEY_ROTATION_WINDOW_HOURS=24
# DEPLOY_HEALTH_URL=http://127.0.0.1:8080
