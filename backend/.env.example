APP_ENV=development
SERVER_ADDR=:8080
DATA_PATH=data/agentinder.json
WEB_ORIGIN=http://localhost:5173
# Solo desarrollo local. Producción debe usar una clave aleatoria privada de 32 bytes en base64.
AGENT_TOKEN_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
# Durante una rotación, deja aquí la(s) clave(s) anterior(es) separadas por coma
# hasta que pasen 24 horas; se usan solo para leer. Ver docs/despliegue.md.
# AGENT_TOKEN_ENCRYPTION_KEY_PREVIOUS=
